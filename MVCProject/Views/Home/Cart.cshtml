@using MVCProject.Models
@model List<Order>

@{
    ViewData["Title"] = "My Orders";
}

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="Home" asp-action="Index">Home</a>
                <span class="breadcrumb-item active">My Orders</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->


<!-- Orders Start -->
<div class="container-fluid pb-5">
    <div class="row px-xl-5">
        <div class="col-12">
            @if (!Model.Any())
            {
                <div class="bg-light p-30 text-center">
                    <p class="mb-0">You have no orders yet.</p>
                    <a asp-controller="Home" asp-action="Shop" class="btn btn-primary mt-3">Start Shopping</a>
                </div>
            }
            else
            {
                @foreach (var order in Model)
                {
                    <div class="bg-light p-30 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">Order #@order.Id — @order.CreatedAt.ToString("dd MMM yyyy HH:mm")</h6>
                            <span class="badge badge-primary">@order.Status</span>
                        </div>
                        <table class="table table-borderless mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Unit Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="width: 40px; height: 40px; object-fit: cover;" class="mr-2" />
                                            @item.Product.Name
                                        </td>
                                        <td>@item.UnitPrice.ToString("C")</td>
                                        <td>@item.Quantity</td>
                                        <td>@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="text-right pt-2 border-top">
                            <h6 class="mb-0">Total: @order.TotalPrice.ToString("C")</h6>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
<!-- Orders End -->
