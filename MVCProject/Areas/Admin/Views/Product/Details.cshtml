@model Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Product Details</h4>
                <div class="row">
                    <div class="col-md-4">
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" />
                    </div>
                    <div class="col-md-8">
                        <table class="table">
                            <tr>
                                <th>Name</th>
                                <td>@Model.Name</td>
                            </tr>
                            <tr>
                                <th>SKU</th>
                                <td>@Model.SKU</td>
                            </tr>
                            <tr>
                                <th>Category</th>
                                <td>@Model.Category?.Name</td>
                            </tr>
                            <tr>
                                <th>Price</th>
                                <td>@Model.Price.ToString("C")</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>@Model.Description</td>
                            </tr>
                            <tr>
                                <th>Created At</th>
                                <td>@Model.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-light">Back to list</a>
            </div>
        </div>
    </div>
</div>
