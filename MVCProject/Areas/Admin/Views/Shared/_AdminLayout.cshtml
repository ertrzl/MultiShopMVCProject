<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/admin/assets/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/admin/assets/vendors/ti-icons/css/themify-icons.css" />
    <link rel="stylesheet" href="~/admin/assets/vendors/css/vendor.bundle.base.css" />
    <link rel="stylesheet" href="~/admin/assets/vendors/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/admin/assets/css/style.css" />
    <link rel="shortcut icon" href="~/admin/assets/images/favicon.png" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="container-scroller">
        <!-- Sidebar Start -->
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            <div class="sidebar-brand-wrapper d-none d-lg-flex align-items-center justify-content-center fixed-top">
                <a class="sidebar-brand brand-logo" asp-area="Admin" asp-controller="Home" asp-action="Index">MultiShop Admin</a>
            </div>
            <ul class="nav">
                <li class="nav-item nav-category">
                    <span class="nav-link">Navigation</span>
                </li>
                <li class="nav-item menu-items">
                    <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <span class="menu-icon"><i class="mdi mdi-speedometer"></i></span>
                        <span class="menu-title">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item menu-items">
                    <a class="nav-link" asp-area="Admin" asp-controller="Product" asp-action="Index">
                        <span class="menu-icon"><i class="mdi mdi-format-list-bulleted"></i></span>
                        <span class="menu-title">Products</span>
                    </a>
                </li>
                <li class="nav-item menu-items">
                    <a class="nav-link" asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <span class="menu-icon"><i class="mdi mdi-shape"></i></span>
                        <span class="menu-title">Categories</span>
                    </a>
                </li>
                <li class="nav-item menu-items">
                    <a class="nav-link" asp-area="Admin" asp-controller="Order" asp-action="Index">
                        <span class="menu-icon"><i class="mdi mdi-cart"></i></span>
                        <span class="menu-title">Orders</span>
                    </a>
                </li>
                @if (User.IsInRole(nameof(MVCProject.Utilities.Enums.AppRole.Admin)))
                {
                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">
                            <span class="menu-icon"><i class="mdi mdi-account-multiple"></i></span>
                            <span class="menu-title">Users</span>
                        </a>
                    </li>
                }
                <li class="nav-item menu-items">
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="menu-icon"><i class="mdi mdi-home"></i></span>
                        <span class="menu-title">Back to Site</span>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- Sidebar End -->

        <div class="container-fluid page-body-wrapper">
            <!-- Navbar Start -->
            <nav class="navbar p-0 fixed-top d-flex flex-row">
                <div class="navbar-brand-wrapper d-flex d-lg-none align-items-center justify-content-center">
                    <a class="navbar-brand brand-logo-mini" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>
                </div>
                <div class="navbar-menu-wrapper flex-grow d-flex align-items-stretch">
                    <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                        <span class="mdi mdi-menu"></span>
                    </button>
                    <ul class="navbar-nav w-100">
                        <li class="nav-item w-100 d-flex align-items-center">
                            <span class="nav-link mt-2 mt-md-0">Admin Panel</span>
                        </li>
                    </ul>
                </div>
            </nav>
            <!-- Navbar End -->

            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">&copy; @DateTime.Now.Year MultiShop Admin</span>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <script src="~/admin/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/admin/assets/js/off-canvas.js"></script>
    <script src="~/admin/assets/js/misc.js"></script>
    <script src="~/admin/assets/js/settings.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
