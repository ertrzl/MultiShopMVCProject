@using System.Security.Claims
@model List<UserVM>

@{
    ViewData["Title"] = "Users";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-3">Users</h4>
                @if (TempData["Error"] is not null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Current Role</th>
                                <th>Change Role</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td><span class="badge bg-primary">@user.CurrentRole</span></td>
                                    <td>
                                        @if (user.Id == currentUserId)
                                        {
                                            <span class="text-muted">This is you</span>
                                        }
                                        else
                                        {
                                            <form asp-area="Admin" asp-controller="User" asp-action="ChangeRole" method="post" class="d-flex">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <select name="role" class="form-control form-control-sm mr-2" style="width: 150px;">
                                                    @foreach (var roleItem in user.Roles)
                                                    {
                                                        if (roleItem.Value == user.CurrentRole)
                                                        {
                                                            <option value="@roleItem.Value" selected="selected">@roleItem.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@roleItem.Value">@roleItem.Text</option>
                                                        }
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
